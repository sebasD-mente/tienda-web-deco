# =============================================================================
#  Deco Vintage Guate — Plantilla de Variables de Entorno
#  Proyecto: Deko Labs | Entorno: Produccion (VPS Hostinger / Dokploy / Docker)
# =============================================================================
#
#  USO:
#    1. Copia este archivo y renonmbralo '.env.local' para desarrollo local.
#       cp .env.example .env.local
#
#    2. Para produccion, inyecta estas variables directamente a traves del
#       panel de "Environment Variables" de Dokploy. NUNCA subas un .env
#       con valores reales al repositorio de Git.
#
#    3. Las variables marcadas [REQUIRED] activan el sistema "Fail-Fast":
#       si no estan definidas, el servidor aborta el arranque con process.exit(1).
#       Esto es intencional y garantiza que nunca corras produccion con
#       credenciales inseguras por defecto.
#
#  SEGURIDAD:
#    OK  Este archivo (.env.example) SI se versiona en Git (sin valores reales).
#    NO  Los archivos .env, .env.local, .env.production NUNCA se versionan.
#    --  Asegurate de que .gitignore contenga: .env .env.local .env.production
#
# =============================================================================


# -- BASE DE DATOS (PostgreSQL) -----------------------------------------------
# [REQUIRED] — URL de conexion al contenedor PostgreSQL gestionado por Dokploy.
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# En produccion Docker, el host es el nombre del servicio en la red Docker (ej: postgres).
DATABASE_URL=postgresql://USUARIO_DB:CONTRASENA_DB@localhost:5432/decovintage?schema=public


# -- AUTENTICACION DEL PANEL ADMIN --------------------------------------------
# [REQUIRED] — Usuario del panel de administracion.
ADMIN_USER=CAMBIA_ESTE_USUARIO

# [REQUIRED] — Contrasena del panel de administracion.
# Minimo 16 caracteres. Usa un generador de contrasenas aleatorio.
# Ejemplo de generacion segura: openssl rand -base64 24
# REQUIRED: El servidor abortara si esta variable esta vacia o ausente.
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_MINIMO_16_CHARS

# [REQUIRED] — Clave secreta maestra para firmar y verificar tokens HMAC-SHA256.
# Usa al menos 32 caracteres aleatorios de alta entropia.
# Ejemplo de generacion segura: openssl rand -hex 32
# REQUIRED: El servidor abortara si esta variable esta vacia o ausente.
# AVISO: Si cambias este valor, todos los tokens existentes quedan invalidados.
ADMIN_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_64_CHARS_HEX


# -- MOTOR DE IA (J.A.R.V.I.S. — Google Gemini) -------------------------------
# [REQUIRED para que J.A.R.V.I.S. funcione con IA real]
# Clave de API de Google AI Studio (https://aistudio.google.com/app/apikey)
# Si no se define, J.A.R.V.I.S. cae al motor heuristico local (fallback offline).
GEMINI_API_KEY=TU_CLAVE_DE_GEMINI_API_AQUI

# [OPTIONAL] — Proyecto de Google Cloud para el fallback de Vertex AI.
# Solo necesario si usas el tier de Vertex AI como segundo fallback.
GOOGLE_CLOUD_PROJECT=tienda-deco-vintage-web


# -- ALMACENAMIENTO CLOUD (Google Cloud Storage - GCS) ------------------------
# [RECOMMENDED para arquitectura 100% Stateless - Factor VI]
# Nombre del bucket configurado en Google Cloud Storage:
GCS_BUCKET_NAME=decovintage-master-media

# Credenciales de Google Cloud (Base64 del archivo application_default_credentials.json)
# Generado con: cat ~/.config/gcloud/application_default_credentials.json | base64 -w 0
GCS_CREDENTIALS_BASE64=PEGA_AQUI_EL_STRING_BASE64_DE_TUS_CREDENCIALES_ADC



# -- CONFIGURACION DEL SERVIDOR -----------------------------------------------
# Puerto interno en el que Express escucha dentro del contenedor Docker.
# Dokploy/Traefik redirige el trafico HTTPS externo a este puerto.
PORT=3000

# Entorno de ejecucion. En produccion SIEMPRE debe ser 'production'.
# Valores validos: development | production
NODE_ENV=production


# -- NOTAS PARA EL EQUIPO DevOps ----------------------------------------------
#
# PERMISOS DE VOLUMENES PERSISTENTES EN EL VPS:
#   El proceso Node.js corre como usuario 'node' (UID 1000) dentro del contenedor.
#   Los volumenes persistentes en el host VPS deben tener el mismo owner.
#
#   Ejecuta esto UNA VEZ en el VPS antes del primer despliegue:
#     sudo chown -R 1000:1000 /ruta/en/host/app_data
#     sudo chown -R 1000:1000 /ruta/en/host/posters_uploads
#
# ROTACION DE SECRETOS:
#   Si ADMIN_SECRET se compromete, haz redeploy inmediato en Dokploy
#   con el nuevo valor para que el cambio tome efecto.
