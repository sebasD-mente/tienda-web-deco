generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id
  name      String   @unique
  icon      String?  @default("🏷️")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posters   Poster[]

  @@map("categories")
}


enum PosterStatus {
  DISPONIBLE
  SEPARADO
  PENDIENTE_PRODUCCION
  EN_PRODUCCION
  LISTO_PARA_ENTREGA
  ENTREGADO
  DESCONTINUADO
}

enum SizeId {
  MINI
  PEQUENO
  MEDIANO
  GRANDE
  GIGANTE
  PERSONALIZADO
}

model Franchise {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  imageUrl  String?
  category  String?
  posters   Poster[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@map("franchises")
}

model Poster {
  id            String       @id @default(uuid())
  legacyId      String?      @unique
  titulo        String
  subtitulo     String?
  descripcion   String?      @db.Text
  categoria     String
  category      Category     @relation(fields: [categoria], references: [id], onUpdate: Cascade, onDelete: Restrict)
  franchise     Franchise?   @relation(fields: [franchiseId], references: [id])
  franchiseId   String?
  tags          String[]     @default([])
  imageUrl      String?
  thumbUrl      String?
  precioMinimo  Decimal?     @db.Decimal(10, 2)
  precioDisplay String?
  sizes         PosterSize[]
  estado        PosterStatus @default(DISPONIBLE)
  isPublished   Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  rating        Decimal?     @db.Decimal(2, 1)
  reviewsCount  Int          @default(0)
  embedding     Float[]      @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([categoria])
  @@index([estado])
  @@index([isFeatured])
  @@index([franchiseId])
  @@index([createdAt])
  @@index([precioMinimo])
  @@index([isPublished, estado, categoria, createdAt])
  @@index([isPublished, estado, createdAt])
  @@map("posters")
}

model PosterSize {
  id          String   @id @default(cuid())
  poster      Poster   @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId    String
  sizeId      String
  nombre      String
  dimensiones String
  anchoCm     Decimal? @db.Decimal(6, 2)
  altoCm      Decimal? @db.Decimal(6, 2)
  precio      Decimal  @db.Decimal(10, 2)
  badge       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([posterId, sizeId])
  @@index([posterId])
  @@map("poster_sizes")
}

model StoreSettings {
  id              String   @id @default("default")
  whatsappPhone   String   @default("50238375078")
  storeName       String   @default("Deco Vintage Guate")
  deliveryMinDays Int      @default(2)
  deliveryMaxDays Int      @default(4)
  customCm2Price  Decimal  @default(0.048) @db.Decimal(6, 4)
  categories      Json?    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("store_settings")
}

model JarvisMemory {
  id              String   @id @default("default")
  apiKey          String?
  systemPrompt    String?  @db.Text
  initialGreeting String?  @db.Text
  quickPrompts    Json     @default("[]")
  referenceImages Json     @default("[]")
  company         Json?
  ownerDirectives Json     @default("[]")
  customDocuments Json     @default("[]")
  faqEntries      Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("jarvis_memory")
}

model CustomOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  totalPrice    Decimal  @db.Decimal(10, 2)
  totalUnits    Int      @default(1)
  items         Json     @default("[]")
  status        String   @default("PENDIENTE")
  customerPhone String?
  customerNotes String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("custom_orders")
}