generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  AUTOS
  SUPERHEROES
  ANIME
  MUSICA
  SERIESYPELICULAS
  OBRASDEARTE
  INFANTILYDIBUJOSANIMADOS
  CINE
}

enum PosterStatus {
  DISPONIBLE
  SEPARADO
  PENDIENTE_PRODUCCION
  EN_PRODUCCION
  LISTO_PARA_ENTREGA
  ENTREGADO
  DESCONTINUADO
}

enum SizeId {
  MINI
  PEQUENO
  MEDIANO
  GRANDE
  GIGANTE
  PERSONALIZADO
}

model Franchise {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  imageUrl  String?
  category  Category?
  posters   Poster[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@map("franchises")
}

model Poster {
  id            String       @id @default(uuid())
  legacyId      String?      @unique
  titulo        String
  subtitulo     String?
  descripcion   String?      @db.Text
  categoria     Category
  franchise     Franchise?   @relation(fields: [franchiseId], references: [id])
  franchiseId   String?
  tags          String[]     @default([])
  imageUrl      String?
  thumbUrl      String?
  precioMinimo  Decimal?     @db.Decimal(10, 2)
  precioDisplay String?
  sizes         PosterSize[]
  estado        PosterStatus @default(DISPONIBLE)
  isPublished   Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  rating        Decimal?     @db.Decimal(2, 1)
  reviewsCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([categoria])
  @@index([estado])
  @@index([isFeatured])
  @@index([franchiseId])
  @@map("posters")
}

model PosterSize {
  id          String   @id @default(cuid())
  poster      Poster   @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId    String
  sizeId      SizeId
  nombre      String
  dimensiones String
  anchoCm     Decimal? @db.Decimal(6, 2)
  altoCm      Decimal? @db.Decimal(6, 2)
  precio      Decimal  @db.Decimal(10, 2)
  badge       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([posterId, sizeId])
  @@index([posterId])
  @@map("poster_sizes")
}